DJANGO_SECRET_KEY=replace-with-a-random-secret
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require
# Optional; when set, this takes precedence over the split DB_* settings.
DATABASE_URL=

# Chrome extension ID; settings add its chrome-extension:// origin to CORS.
TABBOARD_EXTENSION_ID=replace-with-extension-id
# Optional comma-separated additional exact origins.
CORS_ALLOWED_ORIGINS=

GOOGLE_CLIENT_ID=
# Optional for Google Chrome extension access-token sign-in; required for code exchange.
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
